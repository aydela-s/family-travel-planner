# Set these in .env.local for local development.

# Planning / maps
DEMO_MODE=true
# Planner engine: staged (default) | score (legacy rollback). Restart dev after changes.
# PLANNER_ENGINE=staged
# Classic Maps key (optional if GOOGLE_PLACES_API_KEY is set): Static Maps, legacy APIs
GOOGLE_MAPS_API_KEY=
# Places API (New) — Autocomplete, Details, Text Search (FAM-57/58). Falls back to GOOGLE_MAPS_API_KEY.
# Billed per request; in-memory 24h cache keyed by city + category + center (FAM-61).
GOOGLE_PLACES_API_KEY=

# Vercel AI Gateway (FAM-47) — optional family tips on real (non-demo) itineraries
# Create a key: https://vercel.com/dashboard → AI Gateway → API Keys
AI_GATEWAY_API_KEY=
# Optional model override (default: openai/gpt-4o-mini)
# AI_GATEWAY_MODEL=openai/gpt-4o-mini
# Set to false to keep gateway configured but skip tip enrichment
# AI_ENRICH_TIPS=false
# Legacy OpenAI key still accepted as a fallback for local gateway auth
OPENAI_API_KEY=

# Feedback via Resend (FAM-49)
# 1. Create an API key at https://resend.com/api-keys
# 2. For localhost testing, use Resend's onboarding sender and send TO the
#    email on your Resend account (they only allow that address until you
#    verify your own domain).
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=you@example.com
FEEDBACK_FROM_EMAIL=familyTravely Feedback <onboarding@resend.dev>

# PostHog product analytics (client-side only; leave blank to disable locally)
# Project API key from https://app.posthog.com → Project settings
NEXT_PUBLIC_POSTHOG_KEY=
# Capture host: point at the /ingest reverse proxy (next.config.ts) to dodge ad-blockers.
NEXT_PUBLIC_POSTHOG_HOST=/ingest
# UI host: the region the toolbar and app links open (US: https://us.posthog.com).
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

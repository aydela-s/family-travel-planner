# Set these in .env.local for local development.

# Planning / maps
DEMO_MODE=true
GOOGLE_MAPS_API_KEY=

# Vercel AI Gateway (FAM-47) — optional family tips on real (non-demo) itineraries
# Create a key: https://vercel.com/dashboard → AI Gateway → API Keys
AI_GATEWAY_API_KEY=
# Optional model override (default: openai/gpt-4o-mini)
# AI_GATEWAY_MODEL=openai/gpt-4o-mini
# Set to false to keep gateway configured but skip tip enrichment
# AI_ENRICH_TIPS=false
# Legacy OpenAI key still accepted as a fallback for local gateway auth
OPENAI_API_KEY=

# Feedback via Resend (FAM-49)
# 1. Create an API key at https://resend.com/api-keys
# 2. For localhost testing, use Resend's onboarding sender and send TO the
#    email on your Resend account (they only allow that address until you
#    verify your own domain).
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=you@example.com
FEEDBACK_FROM_EMAIL=TripNestly Feedback <onboarding@resend.dev>
